{
  "version": 2,
  "format_id": "kanhuwan-renovation-ledger",
  "format_version": 2,
  "tag_dimensions": ["主题", "空间", "专业", "性质", "渠道", "品牌", "生态", "阶段", "状态"],
  "limits": {"grouped_tags": 24, "tag_length": 40},
  "tools": [
    {"name": "ledger_add_payment", "write": true, "required": ["idempotency_key", "amount_cents", "occurred_on", "grouped_tags"], "forbidden": ["main_category", "tags"]},
    {"name": "ledger_add_refund", "write": true, "required": ["idempotency_key", "original_payment_id", "amount_cents", "occurred_on"]},
    {"name": "ledger_correct_payment", "write": true, "required": ["idempotency_key", "payment_id", "changes", "reason"], "grouped_tag_field": "changes.grouped_tags"},
    {"name": "ledger_undo", "write": true, "required": ["idempotency_key", "transaction_id", "reason"]},
    {"name": "ledger_show", "write": false, "required": ["transaction_id"]},
    {"name": "ledger_query", "write": false, "required": []},
    {"name": "ledger_summary", "write": false, "required": []},
    {"name": "ledger_export", "write": false, "required": []},
    {"name": "ledger_verify_export", "write": false, "required": []}
  ]
}
